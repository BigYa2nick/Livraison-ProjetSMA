# Copier ce fichier en .env puis adapter les valeurs. Ne jamais versionner .env.

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=livraison
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=livraison
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Serveur XMPP (SPADE) ---
XMPP_HOST=localhost
XMPP_PORT=5222
XMPP_DOMAINE=localhost
XMPP_MOT_DE_PASSE_AGENTS=changez-moi

# --- Moteur d'itinéraires ---
OSRM_URL=http://localhost:5000

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
JWT_SECRET=changez-moi-par-une-longue-chaine-aleatoire
